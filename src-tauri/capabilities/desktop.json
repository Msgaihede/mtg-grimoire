{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Capability for every window — `main`, and each `window-N` a relaunch or Ctrl+Shift+N opens.",
  "platforms": ["windows", "linux", "macOS"],
  "windows": ["main", "window-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "snap-layout:allow-update-snap-bounds",
    "snap-layout:allow-detach-snap-bounds",
    "mcp-bridge:allow-report-ipc-event",
    "mcp-bridge:allow-request-script-injection",
    "mcp-bridge:allow-script-result"
  ]
}
