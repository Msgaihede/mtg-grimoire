<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-narrowed from the `tauri android init` template, which shared `external-path "."` and
  `cache-path "."` — the whole of shared external storage and the whole cache directory.

  The only `FileProvider.getUriForFile` call in the build is wry's own
  (`RustWebChromeClient.createImageFileUri`, wry 0.55): when a page's `<input type="file"
  capture>` asks for a photo, it writes a `JPEG_…` temp file into
  `getExternalFilesDir(DIRECTORY_PICTURES)` and hands the camera app a URI for it. That
  directory is `external-files-path` + `Pictures/`, and it is the one path this provider needs
  to name. Nothing in this app renders such an input today; the provider stays so that one
  appearing later gets a working camera rather than an IllegalArgumentException.

  A re-run of `npx tauri android init` restores the template's paths. Review the diff.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-files-path name="captured_images" path="Pictures/" />
</paths>
