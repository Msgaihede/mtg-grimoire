<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
        `android:allowBackup` is unset in the generated template and therefore defaults to
        **true**. It is set to false here, and the privacy reason comes first because it is the
        one that has to survive somebody "fixing" the second.

        1. **No server holds anything this app can read.** There is no account and no signup,
           and the sync that does exist is end-to-end encrypted. Android Auto Backup would copy
           the app's data directory — the reader's collection, their decks, what they paid for
           each card — into their Google Drive, silently, without them ever choosing it. That
           contradicts the whole design.

        2. And it would not even work: the corpus database is ~500 MB against Auto Backup's
           25 MB quota, so the upload fails noisily and repeatedly.

        **Do not read (2) as the argument.** Shrinking the backup set — excluding the corpus,
        which is a rebuildable cache, and keeping the user tables — clears the quota and leaves
        the reader's collection going to Google anyway, which is exactly what (1) refuses.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.mtg_grimoire"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
