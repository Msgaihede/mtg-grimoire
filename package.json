{
  "name": "mtg-grimoire",
  "private": true,
  "version": "0.43.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "types": ".design-sync/dist/.design-sync/entry.d.ts",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc -p packages/ui && tsc -p packages/fake && tsc -p apps/desktop && tsc -p apps/light && tsc -p apps/share && tsc -p .storybook && tsc -p infrastructure/relay && tsc -p infrastructure/share-worker && tsc -p infrastructure/app-worker && tsc -p packages/ui/tsconfig.web-worker.json && tsc -p packages/ui/tsconfig.web-sw.json && vite build --config apps/desktop/vite.config.ts",
    "preview": "vite preview --config apps/desktop/vite.config.ts",
    "tauri": "cd apps/desktop && tauri",
    "share:dev": "vite --config apps/share/vite.config.ts",
    "share:build": "tsc -p apps/share && vite build --config apps/share/vite.config.ts",
    "mobile:dev": "vite --config apps/light/vite.config.ts --mode fake",
    "mobile:serve": "vite --config apps/light/vite.config.ts",
    "mobile:tauri": "cd apps/desktop && tauri dev --config src-tauri/tauri.light.conf.json",
    "mobile:build": "tsc -p apps/light && vite build --config apps/light/vite.config.ts",
    "mobile:scan-smoke": "node scripts/pairing-scan-smoke.mjs",
    "mobile:scanner-smoke": "node scripts/phone-scanner-smoke.mjs",
    "tauri:light": "cd apps/light && tauri",
    "mobile:android": "pnpm tauri:light android dev",
    "web:wasm": "node scripts/build-wasm.mjs",
    "web:dev": "vite --config apps/light/vite.config.ts --mode web",
    "web:build": "tsc -p apps/light && tsc -p packages/ui/tsconfig.web-worker.json && tsc -p packages/ui/tsconfig.web-sw.json && vite build --config apps/light/vite.config.ts --mode web",
    "web:preview": "vite preview --config apps/light/vite.config.ts --mode web",
    "web:smoke": "node scripts/web-smoke.mjs",
    "web:scanner-smoke": "node scripts/web-scanner-smoke.mjs",
    "web:sync-smoke": "node scripts/web-sync-smoke.mjs",
    "web:sync-pull": "node scripts/web-sync-pull.mjs",
    "web:deploy-guard": "node scripts/web-deploy-guard.mjs",
    "lint:claude": "node scripts/check-claude-md.mjs",
    "lint": "eslint . --max-warnings 0 && pnpm lint:claude",
    "lint:rust": "cargo fmt -p mtg-grimoire -p grimoire-core -p grimoire-light -p grimoire-web -p grimoire-scan --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo check -p mtg-grimoire -p grimoire-light --locked",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=30000",
    "test:coverage:rust": "node scripts/coverage-rust.mjs",
    "golden": "node scripts/golden.mjs",
    "scanner:assets": "node scripts/scanner-assets.mjs",
    "scanner:bench": "node scripts/scanner-bench.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify": "pnpm build && vite build --config apps/light/vite.config.ts && pnpm lint && pnpm lint:rust && pnpm test:run && cargo test --workspace && cargo test --manifest-path crates/card-scanner/Cargo.toml --target-dir crates/card-scanner/target --features cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@fontsource/cinzel": "catalog:",
    "@grimoire/fake": "workspace:*",
    "@grimoire/ui": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "catalog:",
    "@tauri-apps/cli": "^2",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "jsdom": "^30.0.1",
    "jsqr": "catalog:",
    "keyrune": "catalog:",
    "mana-font": "catalog:",
    "motion": "catalog:",
    "prettier": "^3.9.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
