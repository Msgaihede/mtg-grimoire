{
  "name": "mtg-grimoire",
  "private": true,
  "version": "0.31.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "types": ".design-sync/dist/.design-sync/entry.d.ts",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p .storybook && tsc -p tsconfig.relay.json && tsc -p tsconfig.share-worker.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "share:dev": "vite --config vite.share.config.ts",
    "share:build": "tsc && vite build --config vite.share.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=30000",
    "test:coverage:rust": "node scripts/coverage-rust.mjs",
    "golden": "node scripts/golden.mjs",
    "scanner:assets": "node scripts/scanner-assets.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify": "npm run build && npm run lint && npm run lint:rust && npm run test:run && cargo test --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path crates/card-scanner/Cargo.toml --features cli"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "keyrune": "^3.19.0",
    "lucide-react": "^1.28.0",
    "mana-font": "^1.18.0",
    "motion": "^13.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.5.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.16.1",
    "storybook": "10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
