{
  "name": "mtg-grimoire",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "types": ".design-sync/dist/.design-sync/entry.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p .storybook && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=30000",
    "test:coverage:rust": "node scripts/coverage-rust.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify": "npm run build && npm run lint && npm run test:run && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.2",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "keyrune": "^3.19.0",
    "lucide-react": "^1.28.0",
    "mana-font": "^1.18.0",
    "motion": "^13.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.5.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.16.1",
    "storybook": "10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
