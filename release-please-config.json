{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore${scope}: release ${version}",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "mtg-grimoire",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='mtg-grimoire')].version"
        },
        {
          "type": "toml",
          "path": "crates/grimoire-core/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='grimoire-core')].version"
        },
        {
          "type": "json",
          "path": "mobile/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "mobile/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='grimoire-light')].version"
        }
      ]
    }
  }
}
