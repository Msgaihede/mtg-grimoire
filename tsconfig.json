{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases (no baseUrl: deprecated in TS 6, paths resolve from this file) */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // The glob is spelled out rather than left as a bare `.storybook` directory entry:
  // TypeScript expands a bare directory to a wildcard, and its wildcard expansion skips
  // dot-directories, so the bare form contributes **zero** files. Measured 2026-08-09 with
  // `tsc --listFiles`: nothing under the bare form, `main.ts` and `preview.tsx` under this
  // one. The point of the entry is that the Storybook fake backend is type-checked, and the
  // bare form fails at that silently.
  "include": ["src", ".storybook/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
