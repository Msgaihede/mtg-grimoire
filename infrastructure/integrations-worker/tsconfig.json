{
  /* The integrations Worker's type-check program. Every compiler option below is
     `infrastructure/relay/tsconfig.json`'s byte for byte, and that file carries the argument for
     why a Worker gets a program of its own: `@cloudflare/workers-types` declares `Request`,
     `Response` and some four hundred other globals, and the app under `packages/ui/` must see the
     DOM's versions of those names and nothing else.

     A fifth file rather than a wider `include` in any of the other four, for
     `infrastructure/share-worker/tsconfig.json`'s reason: `mtg-grimoire-integrations` is a deploy
     of its own, and one program spanning two Workers lets an edit to one fail the other's check.

     **`../relay/src/token.ts` is in the program because this Worker imports it** — `verify`,
     `newestKeys` and `stillInGroup`, the bearer gate (`src/gate.ts`) — and the suite imports its
     `mint`. Named by itself, as the share Worker's program names it: the relay's other modules
     are the relay's own to check.

     **`test/` beside `src/`, and both in the program**: `src/` is exactly the script a deploy
     bundles, so `grep -rn RELAY_HMAC_KEY src` finds the gate and nothing a test needed, and the
     suite — which a test that does not type-check would let drift — is checked all the same.
     `test/env.d.ts` declares what the suite reads that `@cloudflare/workers-types` does not
     have: Node's `node:sqlite` (the object's storage in the suite), Vite's `?raw` and
     `import.meta.glob`, and `process.env` for the measurement's switch. */
  "compilerOptions": {
    "target": "ES2022",
    /* No `DOM`: this is not a browser. `@cloudflare/workers-types` supplies the fetch, stream
       and URL globals workerd actually has, which are a different and smaller set. */
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "../relay/src/token.ts"]
}
