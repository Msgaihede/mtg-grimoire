{
  // Module resolution for the design-sync converter only — never for `npm run build`.
  //
  // It exists because esbuild has no idea what `.storybook/main.ts` does. That file rewrites
  // three imports through a Vite alias array, and every one of them matters here: without the
  // rewrites a preview compiles the *real* `@tauri-apps/api/core`, whose `invoke` has no
  // backend outside the Tauri webview, and the *real* `@/lib/images`, whose `mtgimg://` URLs
  // resolve to nothing on claude.ai/design. Both render a story that is wrong in a way the
  // storybook side is not — which is precisely what the compare loop would then flag.
  //
  // **Order is the contract, exactly as it is in `.storybook/main.ts`.** The converter's
  // `tsconfigPathsPlugin` walks these rules in declaration order and takes the first match, so
  // every exact-match rule must precede the `@/*` wildcard. Move `@/*` up and `@/lib/images`
  // silently resolves to the real module again.
  //
  // **The last rule before the wildcard has no twin in `main.ts`, and that is not an
  // oversight.** Storybook needs none: Vite resolves a directory to its `index.ts`. The
  // converter's resolver hands esbuild the directory itself, and `core-shim.ts` re-exports the
  // real module by its file; its header has the account.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@tauri-apps/api/core": ["../packages/fake/core.ts"],
      "@tauri-apps/api/event": ["../packages/fake/event.ts"],
      "@tauri-apps/api/window": ["../packages/fake/window.ts"],
      "@/lib/images": ["../packages/fake/images.ts"],
      "@/lib/core": ["./core-shim.ts"],
      "@/*": ["../packages/ui/*"],
      // The same two exceptions under the name every other package uses (2026-10-08): the fake's
      // `db.ts` imports the images module as `@grimoire/ui/lib/images`.
      "@grimoire/ui/lib/images": ["../packages/fake/images.ts"],
      "@grimoire/ui/lib/core": ["./core-shim.ts"],
      "@grimoire/ui/*": ["../packages/ui/*"],
      "@grimoire/fake/*": ["../packages/fake/*"]
    }
  }
}
