{
  // Module resolution for the design-sync converter only — never for `npm run build`.
  //
  // It exists because esbuild has no idea what `.storybook/main.ts` does. That file rewrites
  // three imports through a Vite alias array, and every one of them matters here: without the
  // rewrites a preview compiles the *real* `@tauri-apps/api/core`, whose `invoke` has no
  // backend outside the Tauri webview, and the *real* `@/lib/images`, whose `mtgimg://` URLs
  // resolve to nothing on claude.ai/design. Both render a story that is wrong in a way the
  // storybook side is not — which is precisely what the compare loop would then flag.
  //
  // **Order is the contract, exactly as it is in `.storybook/main.ts`.** The converter's
  // `tsconfigPathsPlugin` walks these rules in declaration order and takes the first match, so
  // every exact-match rule must precede the `@/*` wildcard. Move `@/*` up and `@/lib/images`
  // silently resolves to the real module again.
  //
  // **The rules after `@/lib/images` have no twin in `main.ts`, and that is not an
  // oversight.** Storybook needs none: Vite resolves a directory to its `index.ts`, and a name
  // that is both `x.ts` and a folder `x/` to the file. The converter's resolver tries the bare
  // stem first and `existsSync` says yes to a folder, so esbuild is handed the directory and fails
  // with a Windows `Incorrect function`. `@/lib/core` is a folder with an `index.ts`
  // (`core-shim.ts` has the account); `@/lib/ipc` and `@/features/home/widgets` are a file with a
  // folder of the same name beside it, so they are pointed at the file outright.
  // `@/lib/appVersion` reads two Vite `define`s the converter never sets; `appVersion-shim.ts`
  // has the account.
  //
  // **The one relative key is `world.ts`'s `?raw` import of a Rust file** — an exact match on
  // the specifier, which the resolver compares before any wildcard. `membership-raw.ts` has why.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@tauri-apps/api/core": ["../packages/fake/core.ts"],
      "@tauri-apps/api/event": ["../packages/fake/event.ts"],
      "@tauri-apps/api/window": ["../packages/fake/window.ts"],
      "@/lib/images": ["../packages/fake/images.ts"],
      "@/lib/core": ["./core-shim.ts"],
      "@/lib/ipc": ["../packages/ui/lib/ipc.ts"],
      "@/features/home/widgets": ["../packages/ui/features/home/widgets.ts"],
      "@/lib/appVersion": ["./appVersion-shim.ts"],
      "@/*": ["../packages/ui/*"],
      // The same exceptions under the name every other package uses (2026-10-08): the fake's
      // `db.ts` imports the images module as `@grimoire/ui/lib/images`.
      "@grimoire/ui/lib/images": ["../packages/fake/images.ts"],
      "@grimoire/ui/lib/core": ["./core-shim.ts"],
      "@grimoire/ui/lib/ipc": ["../packages/ui/lib/ipc.ts"],
      "@grimoire/ui/features/home/widgets": ["../packages/ui/features/home/widgets.ts"],
      "@grimoire/ui/lib/appVersion": ["./appVersion-shim.ts"],
      "@grimoire/ui/*": ["../packages/ui/*"],
      "@grimoire/fake/*": ["../packages/fake/*"],
      "../../apps/light/src-tauri/src/membership.rs?raw": ["./membership-raw.ts"]
    }
  }
}
