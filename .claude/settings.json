{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-conflict-markers.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/merge-main.sh\" commit",
            "timeout": 90,
            "statusMessage": "Catching this worktree up to main..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/merge-main.sh\" session",
            "timeout": 120,
            "statusMessage": "Catching this worktree up to main..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/worktree-deps.sh\"",
            "timeout": 180,
            "statusMessage": "Checking this worktree for dependencies..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "openrouter@openrouter": false,
    "typesafe@typesafe-ai": false
  },
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:canvas-design": "off",
    "anthropic-skills:web-artifacts-builder": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:schedule": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:setup-claude": "off",
    "anthropic-skills:setup-cowork": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:explain-usage": "user-invocable-only",
    "anthropic-skills:consolidate-memory": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only"
  },
  "env": {}
}
